{
  "permissions": {
    "allow": [
      "Bash(node tools/artgen/artgen-maps.js:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -n --rawfile content README.md '{hookSpecificOutput: {hookEventName: \"SessionStart\", additionalContext: $content}}'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
