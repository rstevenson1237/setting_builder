{
  "permissions": {
    "allow": [
      "Bash(node tools/artgen/artgen-maps.js:*)",
      "Bash(python3 tools/validate_setting.py *)",
      "Bash(python3 tools/space.py *)",
      "Bash(python3 tools/maps.py *)",
      "Bash(python3 tools/metrics.py *)",
      "Bash(python3 tools/build_site.py *)",
      "Bash(python3 tools/build_pdf.py *)",
      "Bash(python3 tools/design.py *)"
    ],
    "ask": [
      "Bash(node tools/artgen/artgen-maps.js report*--issue*)",
      "Bash(npx*artgen-dist*)",
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -n --rawfile content README.md '{hookSpecificOutput: {hookEventName: \"SessionStart\", additionalContext: $content}}'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
